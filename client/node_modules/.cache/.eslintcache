"195","suppressedMessages":"196","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"89"},{"filePath":"197","messages":"198","suppressedMessages":"199","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\index.tsx",[],[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\reportWebVitals.ts",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\App.tsx",["200","201","202","203","204"],[],"import {\r\n  createBrowserRouter,\r\n  RouterProvider,\r\n  createRoutesFromElements,\r\n  Route,\r\n  Navigate,\r\n} from \"react-router-dom\";\r\nimport React, { useEffect, useState } from 'react';\r\nimport { RootLayout } from \"./components/root\";\r\nimport { Homepage } from \"./components/homepage\";\r\nimport { PetSearchPage } from \"./components/petSearch/petSearchPage\";\r\nimport { PetPage } from \"./components/petSearch/petPage\";\r\nimport { ErrorPage } from \"./components/error\";\r\nimport { AuthLayout } from \"./context/userContext/AuthLayout\";\r\nimport { RegisterForm } from \"./components/user/registerForm\";\r\nimport { LoginFrom } from \"./components/user/loginForm\";\r\nimport { MyAccount } from \"./components/user/myAccount\";\r\nimport { CartPage } from \"./components/checkout/cartPage\";\r\nimport { CheckoutPage } from \"./components/checkout/checkoutPage\";\r\nimport { About } from \"./components/about\";\r\nimport { PetAdvice } from \"./components/petAdvice\";\r\nimport { TrainingTips } from \"./components/trainingTips\";\r\nimport { Nutrition } from \"./components/petNutrition\";\r\nimport { Health } from \"./components/health\";\r\nimport { fetchPets as petsLoader, fetchPet as petLoader } from \"./services/api\";\r\n\r\nimport { AdminDashboard } from './components/AdminDashboard';\r\nimport { isAdmin } from './utils/auth';\r\n\r\nimport { AuthProvider } from './context/userContext/useAuth';\r\n\r\nimport useAuth from './context/userContext/useAuth';\r\n\r\nimport { getUser } from './services/api';\r\n\r\n\r\nconst ProtectedRoute: React.FC<{ children: React.ReactNode }> = ({ children }) => {\r\n  const { user } = useAuth();\r\n  \r\n  if (!user || !user.email) {\r\n    return <Navigate to=\"/users/login\" replace />;\r\n  }\r\n  console.log(user.email)\r\n  return <>{children}</>;\r\n};\r\n\r\nexport const router = createBrowserRouter(\r\n  createRoutesFromElements(\r\n    <Route element={<AuthLayout />} errorElement={<ErrorPage />}>\r\n      <Route element={<RootLayout />}>\r\n        <Route path=\"/\" element={<Homepage />} loader={petsLoader} />\r\n        <Route path=\"/pets\" element={<PetSearchPage />} loader={petsLoader} />\r\n        <Route path=\"/pet/:id\" element={<PetPage />} loader={petLoader} />\r\n        <Route path=\"/users/register\" element={<RegisterForm />} />\r\n        <Route path=\"/users/login\" element={<LoginFrom />} />\r\n        <Route path=\"/users/my-account\" element={<MyAccount />} />\r\n        <Route path=\"/cart\" element={<CartPage />} />\r\n        <Route path=\"/checkout\" element={<CheckoutPage />} />\r\n        <Route path=\"/about\" element={<About />} />\r\n        <Route path=\"/petAdvice\" element={<PetAdvice />} />\r\n        <Route path=\"/training\" element={<TrainingTips />} />\r\n        <Route path=\"/nutrition\" element={<Nutrition />} />\r\n        <Route path=\"/health\" element={<Health />} />\r\n        <Route \r\n          path=\"/admin-dashboard\" \r\n          element={\r\n            <ProtectedRoute>\r\n              <AdminDashboard />\r\n            </ProtectedRoute>\r\n          } \r\n        />\r\n      </Route>\r\n    </Route>\r\n  )\r\n);\r\nfunction App() {\r\n  return <RouterProvider router={router} />;\r\n}\r\n\r\nexport default App;\r\n",[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\context\\cartContext\\cartState.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\error.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\root.tsx",[],[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\about.tsx",["205","206"],[],"import { Link } from \"react-router-dom\";\nimport { Carousel } from \"react-responsive-carousel\";\nimport \"react-responsive-carousel/lib/styles/carousel.min.css\";\n\nexport const About = () => {\n  return (\n    <>\n      <h1 className=\"font-medium text-center leading-tight text-5xl my-5 text-slate-700\">\n        Adopting One Life, Enriches Two!\n      </h1>\n\n      <div className=\"video-container\">\n        <video \n           className=\"w-full max-w-4xl mx-auto\"\n           autoPlay\n           muted\n           loop\n           playsInline\n        >\n          <source src=\"../../../uploads/1.mp4\" type=\"video/mp4\" />\n          Your browser does not support the video tag.\n        </video>\n      </div>\n      <div className=\"bg-white py-4\"></div>\n\n      <section className=\"bg-teal-500 text-white py-8 px-4\">\n        <div className=\"container mx-auto flex flex-col md:flex-row\">\n          <img\n            src=\"../../../uploads/getToKnow.png\" // Replace this with your image URL\n            alt=\"Pet Adoption\"\n            className=\"mb-4 w-full md:w-1/2 h-auto\" // Adjusted width for responsiveness\n          />\n\n          <div className=\"w-full md:w-1/2 px-4\">\n            <h1 className=\"font-medium text-center text-5xl my-2 text-slate-700\">\n              Get to know us\n            </h1>\n\n            <p className=\" my-4\">\n              We know pet adoption, because we're adopters too. We think it's just\n              about the best thing you can do. But we'll be real: it can be a lengthy\n              (paperwork-filled) process.\n            </p>\n\n            <p className=\" my-4\">\n              So we're making it easier, with the tools, advice, and transparency you\n              need—from the first search through to daily life as a pet parent.\n            </p>\n\n            <p className=\" my-4\">\n              Because we'll do whatever it takes to help millions of people and pets\n              find each other.\n            </p>\n\n            <p className=\" my-4\">\n              Ready to find your pet? Let's do it.\n            </p>\n          </div>\n        </div>\n      </section>\n\n\n      <section className=\"\">\n        <div className=\"container px-6 py-12 h-full\">\n          <div className=\"flex justify-center items-center lg:items-start lg:flex-wrap flex-col-reverse lg:flex-row h-full g-6 text-gray-800\">\n            <div className=\"flex flex-col mt-12 lg:mt-0 md:w-8/12 lg:w-6/12 mb-12 md:mb-0 justify-center\">\n              <div className=\"flex-row\">\n                <div className=\"flex flex-col sm:flex-row gap-5 bg-white border border-gray-200 rounded-lg shadow\">\n                  <div\n                    className=\"w-full h-80 sm:h-auto sm:w-2/5 sm:shrink-0 lg:h-80 bg-cover bg-center\"\n                    style={{ backgroundImage: \"url(/uploads/sid.jpg)\" }}\n                  ></div>\n                  <div className=\"p-3\">\n                    <h2 className=\"mb-2 text-2xl font-bold mx-auto\">\n                      About the Admin\n                    </h2>\n                    <p className=\"my-2 mx-auto text-left\">\n                      Siddiqua Noorien is a student at Presidnency College, studying MCA.\n                    </p>\n                    <p className=\"my-2 mx-auto text-left\">\n                      Her intrest of study is web development,\n                    </p>\n                    <div className=\"flex flex-row py-2 gap-2\">\n                      <a\n                        href=\"https://github.com/Siddiqua-07\"\n                        target=\"_blank\"\n                        title=\"Oxford Pet Dataset\"\n                        rel=\"noreferrer\"\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          width=\"24\"\n                          height=\"24\"\n                          viewBox=\"0 0 24 24\"\n                        >\n                          <path d=\"M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z\" />\n                        </svg>\n                      </a>\n                      <a\n                        href=\"https://www.linkedin.com/in/siddiqua-noorien-2b015429a/\"\n                        target=\"_blank\"\n                        title=\"Oxford Pet Dataset\"\n                        rel=\"noreferrer\"\n                      >\n                        <svg\n                          xmlns=\"http://www.w3.org/2000/svg\"\n                          width=\"24\"\n                          height=\"24\"\n                          viewBox=\"0 0 24 24\"\n                        >\n                          <path d=\"M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z\" />\n                        </svg>\n                      </a>\n                      {/* <a href=\"\">\n                            linkedin.com/in/CaseyConlin\n                        </a> */}\n                    </div>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n          \n          </div>\n        </div>\n      </section>\n    </>\n  );\n};\n","C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\homepage.tsx",["207"],[],"import { Link } from \"react-router-dom\";\nimport { Carousel } from \"./carousel/carousel\";\n\n\nexport const Homepage = () => {\n  return (\n    <div className=\"container mx-auto px-4\">\n      <div className=\"hero-section flex items-center\">\n        \n      </div>\n\n      <Carousel />\n\n      <p className=\"w-10/12 my-5 text-lg font-bold mx-auto text-center\">\n        If you have any questions contact{\" \"}\n        <a className=\"text-blue-800\" href=\"mailto:sidnoor15@gmail.com\">\n          Siddiqua Noorien\n        </a>\n      </p>\n    </div>\n  );\n};","C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petSearch\\petSearchPage.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petSearch\\petPage.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\user\\registerForm.tsx",["208"],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\user\\loginForm.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\context\\userContext\\AuthLayout.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\user\\myAccount.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\checkout\\cartPage.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\checkout\\checkoutPage.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\services\\api.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\context\\cartContext\\cartContext.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\context\\cartContext\\cartReducer.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\navBar.tsx",["209","210"],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\helpers.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\context\\userContext\\useAuth.tsx",["211","212"],[],"import {\r\n  createContext,\r\n  ReactNode,\r\n  useContext,\r\n  useEffect,\r\n  useMemo,\r\n  useState,\r\n} from \"react\";\r\nimport { useNavigate, useLocation } from \"react-router-dom\";\r\nimport {\r\n  registerUser,\r\n  loginUser,\r\n  logoutUser,\r\n  getUser,\r\n} from \"../../services/api\";\r\n\r\nconst AuthContext = createContext<AuthContextType>({} as AuthContextType);\r\n\r\n// Export the provider as we need to wrap the entire app with it\r\nexport function AuthProvider({\r\n  children,\r\n}: {\r\n  children: ReactNode;\r\n}): JSX.Element {\r\n  const [user, setUser] = useState<User>();\r\n  const [message, setMessage] = useState<AuthMessage>();\r\n  const [error, setError] = useState<any>();\r\n  const [loading, setLoading] = useState<boolean>(false);\r\n  const [loadingInitial, setLoadingInitial] = useState<boolean>(true);\r\n  const navigate = useNavigate();\r\n  const location = useLocation();\r\n\r\n  useEffect(() => {\r\n    if (error) setError(null);\r\n  }, [location.pathname]);\r\n\r\n  useEffect(() => {\r\n    getUser()\r\n      .then((data) => {\r\n        setUser(data.user);\r\n      })\r\n      .catch((_error) => {})\r\n      .finally(() => setLoadingInitial(false));\r\n  }, []);\r\n\r\n  const register = (user: RegisterUser) => {\r\n    setLoading(true);\r\n    setError(undefined);\r\n    registerUser(user)\r\n      .then((data) => {\r\n        setUser(data.user);\r\n        setMessage(data.message);\r\n        setTimeout(() => {\r\n          setMessage(undefined);\r\n          navigate(\"/users/login\");\r\n        }, 2000);\r\n      })\r\n      .catch((err) => setError(err))\r\n      .finally(() => setLoading(false));\r\n  };\r\n\r\n  const login = (user: LoginUser) => {\r\n    setLoading(true);\r\n    setError(undefined);\r\n    loginUser(user)\r\n      .then((data) => {\r\n        setUser(data.user);\r\n        setMessage(data.message);\r\n        setTimeout(() => {\r\n          setMessage(undefined);\r\n          navigate(\"/users/my-account\");\r\n        }, 2000);\r\n      })\r\n      .catch((err) => setError(err))\r\n      .finally(() => setLoading(false));\r\n  };\r\n\r\n  const logout = () => {\r\n    logoutUser().then((data) => {\r\n      setUser(undefined);\r\n      setMessage(data.message);\r\n      setTimeout(() => {\r\n        setMessage(undefined);\r\n        navigate(\"/\");\r\n      }, 2000);\r\n    });\r\n  };\r\n\r\n  const memoedValue = useMemo(\r\n    () => ({\r\n      user,\r\n      message,\r\n      error,\r\n      loading,\r\n      register,\r\n      login,\r\n      logout,\r\n    }),\r\n    [user, message, error, loading]\r\n  );\r\n\r\n  return (\r\n    <AuthContext.Provider value={memoedValue}>\r\n      {!loadingInitial && children}\r\n    </AuthContext.Provider>\r\n  );\r\n}\r\n\r\nexport default function useAuth() {\r\n  return useContext(AuthContext);\r\n}\r\n\r\n","C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petSearch\\pagination.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petSearch\\petCard.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petSearch\\searchBar.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\carousel\\carousel.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\checkout\\cartItem.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\checkout\\stripeComponent.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\checkout\\checkoutCard.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\context\\cartContext\\cartTypes.ts",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\carousel\\carouselItem.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\checkout\\paymentForm.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petAdvice.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\trainingTips.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\petNutrition.tsx",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\health.tsx",["213"],[],"import React from 'react';\r\n\r\nexport const Health = () => {\r\n  return (\r\n    <div className=\"health-container\">\r\n    {/* Main Header Image */}\r\n    <div className=\"header-image\">\r\n      {/* Placeholder for the main image */}\r\n      <img\r\n        src=\"../../../uploads/healthHeader.jpg\"\r\n        alt=\"Pet Health Header\"\r\n        className=\"header-img\"\r\n      />\r\n    </div>\r\n\r\n    <div className=\"content-wrapper\">\r\n   \r\n      <p>Keeping your pet healthy is crucial for a happy and long life. Here are key tips to ensure your pet stays in top shape.</p>\r\n      <h1></h1>\r\n      {/* Section 1 */}\r\n      <div className=\"tip-section first-tip-section\">\r\n        <h2>1. Regular Veterinary Visits</h2>\r\n\r\n        <div className=\"tip-content\">\r\n          {/* Left: Text content */}\r\n          <div className=\"tip-text\">\r\n            <p>\r\n              Make sure to take your pet for regular checkups. Preventive care is essential to catch any health issues early and ensure vaccinations and treatments are up to date.\r\n            </p>\r\n          </div>\r\n          {/* Right: Image placeholder */}\r\n          <div className=\"tip-image-wrapper\">\r\n            <img\r\n              src=\"../../../uploads/vetVisit.jpg\"\r\n              alt=\"Veterinary Visits\"\r\n              className=\"tip-image\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Section 2 */}\r\n      <div className=\"tip-section second-tip-section\">\r\n        <h2>2. Proper Dental Care</h2>\r\n\r\n        <div className=\"tip-content\">\r\n          {/* Left: Image placeholder */}\r\n          <div className=\"tip-image-wrapper\">\r\n            <img\r\n              src=\"../../../uploads/dental.jpg\"\r\n              alt=\"Dental Care\"\r\n              className=\"tip-image\"\r\n            />\r\n          </div>\r\n\r\n          {/* Right: Text content */}\r\n          <div className=\"tip-text\">\r\n            <p>\r\n              Dental hygiene is just as important for pets as it is for humans. Regularly brushing your pet’s teeth or providing dental treats helps avoid plaque buildup and gum disease.\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Section 3 */}\r\n      <div className=\"tip-section first-tip-section\">\r\n        <h2>3. Exercise and Mental Stimulation</h2>\r\n\r\n        <div className=\"tip-content\">\r\n          {/* Left: Text content */}\r\n          <div className=\"tip-text\">\r\n            <p>\r\n              Regular exercise keeps your pet physically fit, while mental stimulation through play and training helps keep them sharp and happy. Ensure you’re providing both physical and mental activities.\r\n            </p>\r\n          </div>\r\n          {/* Right: Image placeholder */}\r\n          <div className=\"tip-image-wrapper\">\r\n            <img\r\n              src=\"../../../uploads/mental.jpg\"\r\n              alt=\"Exercise and Mental Stimulation\"\r\n              className=\"tip-image\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Section 4 */}\r\n      <div className=\"tip-section second-tip-section\">\r\n        <h2>4. Proper Grooming</h2>\r\n\r\n        <div className=\"tip-content\">\r\n          {/* Left: Image placeholder */}\r\n          <div className=\"tip-image-wrapper\">\r\n            <img\r\n              src=\"../../../uploads/dog-grooming.webp\"\r\n              alt=\"Proper Grooming\"\r\n              className=\"tip-image\"\r\n            />\r\n          </div>\r\n\r\n          {/* Right: Text content */}\r\n          <div className=\"tip-text\">\r\n            <p>\r\n              Grooming is vital for your pet’s overall health. Regular brushing, bathing, nail trimming, and ear cleaning can prevent skin issues, infections, and other health concerns.\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      {/* Section 5 */}\r\n      <div className=\"tip-section first-tip-section\">\r\n        <h2>5. Parasite Prevention</h2>\r\n\r\n        <div className=\"tip-content\">\r\n          {/* Left: Text content */}\r\n          <div className=\"tip-text\">\r\n            <p>\r\n              Fleas, ticks, and worms can cause major health problems in pets. Use recommended parasite preventives and check your pet regularly for signs of infestation.\r\n            </p>\r\n          </div>\r\n          {/* Right: Image placeholder */}\r\n          <div className=\"tip-image-wrapper\">\r\n            <img\r\n              src=\"../../../uploads/parasite.webp\"\r\n              alt=\"Parasite Prevention\"\r\n              className=\"tip-image\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  );\r\n};\r\n\r\n","C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\utils\\auth.ts",[],[],"C:\\Users\\siddn\\Github\\MERN-Full-Stack-Pet-Adoption-App-main\\backend\\client\\src\\components\\AdminDashboard.tsx",[],[],{"ruleId":"214","severity":1,"message":"215","line":8,"column":17,"nodeType":"216","messageId":"217","endLine":8,"endColumn":26},{"ruleId":"214","severity":1,"message":"218","line":8,"column":28,"nodeType":"216","messageId":"217","endLine":8,"endColumn":36},{"ruleId":"214","severity":1,"message":"219","line":28,"column":10,"nodeType":"216","messageId":"217","endLine":28,"endColumn":17},{"ruleId":"214","severity":1,"message":"220","line":30,"column":10,"nodeType":"216","messageId":"217","endLine":30,"endColumn":22},{"ruleId":"214","severity":1,"message":"221","line":34,"column":10,"nodeType":"216","messageId":"217","endLine":34,"endColumn":17},{"ruleId":"214","severity":1,"message":"222","line":1,"column":10,"nodeType":"216","messageId":"217","endLine":1,"endColumn":14},{"ruleId":"214","severity":1,"message":"223","line":2,"column":10,"nodeType":"216","messageId":"217","endLine":2,"endColumn":18},{"ruleId":"214","severity":1,"message":"222","line":1,"column":10,"nodeType":"216","messageId":"217","endLine":1,"endColumn":14},{"ruleId":"214","severity":1,"